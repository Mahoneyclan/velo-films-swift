# Xcode
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcworkspace/contents.xcworkspacedata
*.xcuserstate
DerivedData/
.DS_Store

# Swift Package Manager
.build/
*.resolved

# ML model (generated — run Scripts/export_coreml.py to rebuild)
**/VeloYOLO.mlpackage/

# Credentials (never commit)
**/Secrets.swift

# Music — user-supplied tracks; never commit copyrighted audio
**/Resources/music/*.mp3
**/Resources/music/*.m4a
**/Resources/music/*.aac
**/Resources/music/*.wav

# Build artefacts (top-level only, not source step directories)
/build/
Shared/Resources/

# Compiled app bundles — versioned builds and any .app in the repo root
*.app/
VeloFilms/VeloFilms\ v*/

# Compiled ML models (generated from .mlpackage — not source)
**/*.mlmodelc/

# macOS metadata
**/.DS_Store